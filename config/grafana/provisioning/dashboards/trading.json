{
  "dashboard": {
    "title": "Polymarket Trading Bot — Live Dashboard",
    "description": "Real-time trading metrics from the Polymarket AI Trading System",
    "tags": ["trading", "polymarket", "crypto"],
    "timezone": "browser",
    "editable": true,
    "panels": [
      {
        "id": 1,
        "title": "Account Balance",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
        "targets": [{"expr": "trading_balance_usd", "legendFormat": "Balance"}],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 50},
                {"color": "green", "value": 100}
              ]
            },
            "unit": "currencyUSD",
            "decimals": 2
          }
        }
      },
      {
        "id": 2,
        "title": "Realized P&L (24h)",
        "type": "stat",
        "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
        "targets": [{"expr": "trading_daily_pnl_usd", "legendFormat": "24h P&L"}],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 0}
              ]
            },
            "unit": "currencyUSD",
            "decimals": 2
          }
        }
      },
      {
        "id": 3,
        "title": "Win Rate",
        "type": "gauge",
        "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
        "targets": [{"expr": "trading_win_rate * 100", "legendFormat": "Win Rate"}],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 60},
                {"color": "green", "value": 80}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Drawdown",
        "type": "stat",
        "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
        "targets": [{"expr": "trading_drawdown_pct * 100", "legendFormat": "Drawdown"}],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 1,
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 10},
                {"color": "red", "value": 20}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Open Positions",
        "type": "stat",
        "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
        "targets": [{"expr": "trading_open_positions", "legendFormat": "Open"}]
      },
      {
        "id": 6,
        "title": "Active Trades",
        "type": "stat",
        "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
        "targets": [{"expr": "trading_active_trades", "legendFormat": "Active"}]
      },
      {
        "id": 7,
        "title": "Balance History",
        "type": "graph",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
        "targets": [{"expr": "trading_balance_usd", "legendFormat": "Balance"}],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2
          }
        }
      },
      {
        "id": 8,
        "title": "Daily P&L History",
        "type": "graph",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
        "targets": [{"expr": "trading_daily_pnl_usd", "legendFormat": "Daily P&L"}],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 0}
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Win Rate Over Time",
        "type": "graph",
        "gridPos": {"x": 0, "y": 12, "w": 8, "h": 6},
        "targets": [{"expr": "trading_win_rate * 100", "legendFormat": "Win Rate %"}],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        }
      },
      {
        "id": 10,
        "title": "Drawdown Over Time",
        "type": "graph",
        "gridPos": {"x": 8, "y": 12, "w": 8, "h": 6},
        "targets": [{"expr": "trading_drawdown_pct * 100", "legendFormat": "Drawdown %"}],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 1,
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 10},
                {"color": "red", "value": 20}
              ]
            }
          }
        }
      },
      {
        "id": 11,
        "title": "Trade Volume",
        "type": "graph",
        "gridPos": {"x": 16, "y": 12, "w": 8, "h": 6},
        "targets": [{"expr": "rate(trades_total[5m])", "legendFormat": "Trades/min"}]
      },
      {
        "id": 12,
        "title": "Trade Results Breakdown",
        "type": "piechart",
        "gridPos": {"x": 0, "y": 18, "w": 6, "h": 6},
        "targets": [
          {"expr": "trades_total{result=\"win\"}", "legendFormat": "Wins"},
          {"expr": "trades_total{result=\"loss\"}", "legendFormat": "Losses"}
        ]
      },
      {
        "id": 13,
        "title": "Request Latency",
        "type": "graph",
        "gridPos": {"x": 6, "y": 18, "w": 10, "h": 6},
        "targets": [{"expr": "rate(http_request_duration_seconds_sum[5m]) / rate(http_request_duration_seconds_count[5m])", "legendFormat": "Avg Latency"}],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 3
          }
        }
      },
      {
        "id": 14,
        "title": "API Request Rate",
        "type": "graph",
        "gridPos": {"x": 16, "y": 18, "w": 8, "h": 6},
        "targets": [
          {"expr": "rate(http_requests_total{status=\"2xx\"}[5m])", "legendFormat": "2xx"},
          {"expr": "rate(http_requests_total{status=\"4xx\"}[5m])", "legendFormat": "4xx"},
          {"expr": "rate(http_requests_total{status=\"5xx\"}[5m])", "legendFormat": "5xx"}
        ]
      }
    ],
    "refresh": "5s",
    "schemaVersion": 36,
    "version": 2
  }
}
