# Polymarket Trading Bot — Environment Configuration
# Copy to .env and fill in your values. All defaults are CONSERVATIVE.

# === REQUIRED ===
FASTAPI_API_KEY=change-me-to-a-random-secret

# === Polymarket API (for live trading) ===
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
PRIVATE_KEY=

# === Trading Mode ===
POLYMARKET_ALLOW_REAL_ORDERS=false
ENABLE_LIVE_TRADING=false
POLYMARKET_SANDBOX=true

# === Trading (conservative) ===
STARTING_BALANCE=100.0
MAX_POSITION_PCT=0.10
MIN_EDGE=0.08
MIN_CONFIDENCE=85
MIN_VOLUME=10000
PRICE_MIN=0.05
PRICE_MAX=0.50
MIN_EV=0.10
MIN_BET=1.0

# === Risk (conservative) ===
STOP_LOSS_PCT=0.15
TAKE_PROFIT_PCT=0.50
DAILY_LOSS_LIMIT=0.05
MAX_DAILY_TRADES=5
MAX_DRAWDOWN=0.25
