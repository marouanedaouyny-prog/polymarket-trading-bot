# Copy this file to `.env` and `config/.env`
# Paper mode is the safe default.

# Core runtime
ENVIRONMENT=development
DEBUG=True
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false

# Trading defaults for paper mode
STARTING_BALANCE=20.00
MAX_POSITION_PCT=0.15
MAX_POSITION_SIZE=0.05
MIN_EDGE=0.65
MIN_CONFIDENCE=65
MIN_VOLUME=15000
PRICE_MIN=0.01
PRICE_MAX=0.35
STOP_LOSS_PCT=0.25
TAKE_PROFIT_PCT=2.0
DAILY_LOSS_LIMIT=0.10
MAX_DAILY_TRADES=100
MAX_DRAWDOWN=0.10
MAX_DAILY_LOSS_ABS=-20.0
MAX_CONSECUTIVE_LOSSES=3

# Live trading settings
# Only un-comment these when you have verified credentials and risk controls.
# TRADING_MODE=live
# ENABLE_LIVE_TRADING=true
# POLYMARKET_ALLOW_REAL_ORDERS=true
# STARTING_BALANCE=100.00
# MAX_POSITION_PCT=0.05
# MAX_POSITION_SIZE=0.02
# DAILY_LOSS_LIMIT=0.05
# MAX_DAILY_TRADES=20
# MAX_DAILY_LOSS_ABS=-10.0
# MAX_CONSECUTIVE_LOSSES=2

# Polymarket access
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_DEPOSIT_WALLET=
DEPOSIT_WALLET_ADDRESS=
PRIVATE_KEY=
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
POLYMARKET_BUILDER_CODE=
POLYMARKET_DEVELOPER_ADDRESS=
POLYMARKET_DEVELOPER_CODE=
POLYMARKET_SIGNER_ADDRESS=
POLYMARKET_API_KEY_SECONDARY=
POLYMARKET_GAMMA_API_KEY=
POLYMARKET_API_URL=https://gamma-api.polymarket.com
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_SANDBOX=false
POLYMARKET_VERIFY_SSL=true
POLYMARKET_MAX_RETRIES=3
POLYMARKET_MARKET_ORDER_TYPE=FOK
POLYMARKET_ALLOW_REAL_ORDERS=false

# API and dashboard security
FASTAPI_API_KEY=change-me
SECRET_KEY=change-me-too

# Database and cache
DB_HOST=localhost
DB_PORT=5432
DB_NAME=polymarket_trading
DB_USER=trader
DB_PASSWORD=secret123
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Logging and model config
LOG_LEVEL=INFO
LOG_FILE=data/logs/trading.log
MODEL_PATH=models/comprehensive_model.json

# Optional notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
